{
  "name": "SASRec-Beauty-demo",
  "embedding_dim": 128,
  "loss": "bce",
  "batch_size": 128,
  "learning_rate": 0.0005,
  "n_sample": 2048,
  "sample_alpha": 0.5,
  "n_epochs": 200,
  "max_len": 50,
  "num_blocks": 2,
  "num_heads": 2,
  "dropout": 0.2,
  "l2_reg": 0.0,
  "bpreg": 1.0,
  "elu_param": 0.5,
  "device": "cuda",
  "use_pos_emb": true,
  "use_biases": false,
  "trainable": true,
  "verbose": true,
  "seed": 2025,
  "model_selection": "best",
  "val_eval_every": 10,
  "val_k": 10,
  "val_metric": "ndcg"
}
